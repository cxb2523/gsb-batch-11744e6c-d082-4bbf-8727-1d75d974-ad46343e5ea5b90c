{
  "name": "react-video-seek-slider",
  "description": "YouTube-style video seek bar for React: chapters, sprite/WebVTT preview thumbnails, watch heatmap and touch support. Lightweight, zero dependencies.",
  "version": "9.0.1",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "bin": {
    "react-video-seek-slider": "./scripts/generate-thumbnails.mjs"
  },
  "author": "Sergey Egorov",
  "license": "MIT",
  "keywords": [
    "react",
    "react-component",
    "video",
    "video-player",
    "seek",
    "seekbar",
    "seek-bar",
    "slider",
    "scrubber",
    "progress-bar",
    "timeline",
    "youtube",
    "chapters",
    "time-codes",
    "video-preview",
    "thumbnails",
    "sprite",
    "webvtt",
    "vtt",
    "heatmap",
    "typescript",
    "media",
    "player"
  ],
  "files": [
    "lib",
    "styles.css",
    "scripts/generate-thumbnails.mjs"
  ],
  "scripts": {
    "dev": "vite --config vite-dev.config.ts",
    "build": "npm run test && vite build",
    "build:lib": "vite build",
    "build:docs": "vite build --config vite-docs.config.ts",
    "preview": "vite preview",
    "preview:docs": "vite preview --config vite-docs.config.ts",
    "prepublishOnly": "npm run build",
    "test": "vitest run --environment jsdom",
    "lint": "eslint  --quiet",
    "lint:fix": "eslint  --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.3",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jiti": "^2.5.1",
    "jsdom": "^26.1.0",
    "postcss": "^8.5.6",
    "postcss-preset-env": "^10.2.4",
    "postcss-short": "^5.0.0",
    "prettier": "^3.6.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "sass": "^1.89.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^7.0.6",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/egorovsa/react-video-seek-slider.git"
  },
  "homepage": "https://egorovsa.github.io/react-video-seek-slider",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "browserslist": [
    "> 1%",
    "last 5 versions",
    "not dead"
  ]
}
