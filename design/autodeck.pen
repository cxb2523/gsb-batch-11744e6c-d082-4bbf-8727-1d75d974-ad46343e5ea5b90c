                                          "type": "text",
                                          "id": "p6uaRM",
                                          "name": "JSON",
                                          "fill": "$text-2",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "<library>/pairs.json\n{\n  \"despacito→bella-ciao\": {\n    \"effect\": \"bass_swap\",\n    \"loved\": 3,\n    \"avoided\": 0,\n    \"why\": null,        // \"songs\" | \"effect\"\n    \"last\": \"2026-10-25T22:14\"\n  }\n}",
                                          "lineHeight": 1.55,
                                          "fontFamily": "$font-mono",
                                          "fontSize": 13,
                                          "fontWeight": "normal"
                                        }
                                      ]
                                    },
                                    {
                                      "type": "frame",
                                      "id": "nm3wE",
                                      "name": "Rules",
                                      "width": "fill_container",
                                      "layout": "vertical",
                                      "gap": 8,
                                      "children": [
                                        {
                                          "type": "text",
                                          "id": "d0zV0",
                                          "name": "Rule",
                                          "fill": "$text-2",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "•  Key is directional: A → B. B → A gets half the credit, since songs that blend one way usually blend the other way too.",
                                          "lineHeight": 1.45,
                                          "fontFamily": "$font-body",
                                          "fontSize": 13,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "text",
                                          "id": "v3kR3z",
                                          "name": "Rule",
                                          "fill": "$text-2",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "•  🔥 adds 1. 👎 resets the pair to avoided. Tapping again undoes your last rating.",
                                          "lineHeight": 1.45,
                                          "fontFamily": "$font-body",
                                          "fontSize": 13,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "text",
                                          "id": "G3PuS",
                                          "name": "Rule",
                                          "fill": "$text-2",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "•  “Wrong effect” avoids only that effect for the pair. The songs can still meet, with a different effect.",
                                          "lineHeight": 1.45,
                                          "fontFamily": "$font-body",
                                          "fontSize": 13,
                                          "fontWeight": "normal"
                                        },
                                        {
                                          "type": "text",
                                          "id": "yTRac",
                                          "name": "Rule",
                                          "fill": "$text-2",
                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "•  Songs dropped from the library keep their pairs, so re-adding the link brings the memory back.",
                                          "lineHeight": 1.45,
                                          "fontFamily": "$font-body",
                                          "fontSize": 13,
                                          "fontWeight": "normal"
                                        }
                                      ]
