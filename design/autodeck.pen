                                  "type": "text",
                                  "id": "Pw7GV",
                                  "name": "What",
                                  "fill": "$text-2",
                                  "textGrowth": "fixed-width",
                                  "width": "fill_container",
                                  "content": "For engineering: one small file next to pool.json and moods.json. Written on every rating, so a crash or restart loses nothing.",
