                    {
                      "type": "text",
                      "id": "qi6Gf",
                      "name": "Rules",
                      "fill": "$text-2",
                      "textGrowth": "fixed-width",
                      "width": 1200,
                      "content": "Rules · Only transform and opacity animate (the audio engine shares the main thread). No looping animation outside a mix. prefers-reduced-motion: the handover and effect landing become instant swaps; real-time values keep updating. Every change is also announced in the status live region, e.g. “Mixing into Walking The Wire, bass swap”.",
                      "lineHeight": 1.55,
                      "fontFamily": "$font-body",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
                }
