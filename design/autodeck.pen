                                          "textGrowth": "fixed-width",
                                          "width": "fill_container",
                                          "content": "dj_mcp.py serves /mcp (streamable HTTP, 127.0.0.1 only, no auth) and drives the app through its own HTTP API. The app can’t tell an assistant’s call from a click.",
                                          "lineHeight": 1.45,
                                          "fontFamily": "$font-body",
